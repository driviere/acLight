rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /tenants/{tenantId}/{allPaths=**} {
      // Allow read for everyone (logos are public)
      allow read: if true; 
      
      // Allow write only if user is logged in, is an admin, and belongs to this tenant
      allow write: if request.auth != null && 
                     firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.tenant_id == tenantId &&
                     firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
