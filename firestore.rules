rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Basic rules: allow read/write to authenticated users for now.
    // In a real production environment, you would restrict these further
    // by user roles (e.g., only admins can write to accounts/users).

    match /users/{userId} {
      // Users can only read/write their own document, or an admin can access all.
      allow read, write: if request.auth != null;
    }
    
    match /accounts/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    match /journal_entries/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    match /items/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    match /customers/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    match /vendors/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
