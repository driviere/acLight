rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User metadata and tenant mapping
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    
    // Multi-tenant data isolation
    match /tenants/{tenantId} {
      // Allow read/write to the tenant root document (containing branding/setup info)
      allow read, write: if request.auth != null;

      // Allow read/write to all nested data inside this specific tenant
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
